COMPOSE_PROJECT_NAME=cutedsl-dev
CUTEDSL_IMAGE=ai-system/cutedsl-dev:cuda12.9
CUTEDSL_CONTAINER_NAME=cutedsl_dev
CUTEDSL_HOSTNAME=cutedsl-dev

# Relative paths are resolved from this compose directory.
# The default mounts the AI_system repository root at /workspace.
WORKSPACE_PATH=../..

# On Linux, set these to the output of: id -u && id -g
DOCKER_USER=cutedsl
USER_ID=1000
GROUP_ID=1000

SHM_SIZE=16gb
NVIDIA_VISIBLE_DEVICES=all
