# Copy to .env.vllm033; keep the existing cutedsl .env unchanged.
VLLM_COMPOSE_PROJECT_NAME=vllm033-dev
VLLM_DEV_IMAGE=ai-system/vllm-dev:0.33.0-cu130
VLLM_CONTAINER_NAME=vllm033_dev
VLLM_DOCKER_USER=vllmdev
USER_ID=1000
GROUP_ID=1000
SHM_SIZE=16gb
# Verified mount of cutedsl_dev on 192.168.88.91; path is on the Linux host.
WORKSPACE_PATH=/home/cdky/vic/project/02_kycv/WVisonGuard/train_part
# Existing bridge: 172.22.0.0/16, gateway 172.22.0.1. IP is allocated by Docker.
CUTEDSL_NETWORK=cutedsl-dev_default
