FROM nvidia/cuda:12.9.2-devel-ubuntu22.04

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_NAME=cutedsl
ARG USER_UID=1000
ARG USER_GID=1000

ENV CUDA_HOME=/usr/local/cuda \
    VIRTUAL_ENV=/opt/cutedsl-venv \
    PATH=/opt/cutedsl-venv/bin:/usr/local/cuda/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:${LD_LIBRARY_PATH} \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    TORCH_CUDA_ARCH_LIST=8.9 \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
        bash-completion \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        less \
        ninja-build \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        sudo \
        vim-tiny \
        wget \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid "${USER_GID}" "${USER_NAME}" \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" --create-home --shell /bin/bash "${USER_NAME}" \
    && echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USER_NAME}" \
    && chmod 0440 "/etc/sudoers.d/${USER_NAME}"

RUN python3 -m venv "${VIRTUAL_ENV}" \
    && python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install \
        torch==2.8.0 \
        torchvision==0.23.0 \
        torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu129 \
    && python -m pip install \
        nvidia-cutlass-dsl \
        jupyterlab \
        mypy==1.19.1 \
        numpy \
        pytest \
    && chown -R "${USER_UID}:${USER_GID}" "${VIRTUAL_ENV}"

RUN mkdir -p /workspace \
    && chown "${USER_UID}:${USER_GID}" /workspace \
    && printf '%s\n' \
        'source /opt/cutedsl-venv/bin/activate' \
        'export CUDA_HOME=/usr/local/cuda' \
        'export TORCH_CUDA_ARCH_LIST=8.9' \
        >> "/home/${USER_NAME}/.bashrc"

WORKDIR /workspace
USER ${USER_NAME}

CMD ["sleep", "infinity"]
